# --- Reference-only history (NOT in training) ---------------------------------
# These earlier albums have real first-week numbers, but adding them to training
# measurably hurt holdout accuracy and skewed predictions upward (tested individually
# and combined; the dataset is too small and high-variance to absorb them safely).
# Kept here only as documentation and for manual "years since last album" lookups.
#
# Bad Bunny,UltimoTourDelMundo,2020,3,16,299,9.5,3,0,0,0,0,274,1
# Post Malone,TwelveCaratToothache,2022,1,14,489,8.5,37,0,6,3,379,142,1
# Tyler The Creator,CallMeIfYouGetLost,2021,1,16,365,9.0,10,0,12,2,0,133,0
# Billie Eilish,HappierThanEver,2021,0,16,365,9.0,74,0,0,2,0,178,1
# Taylor Swift,Folklore,2020,0,16,299,8.5,1,1,1,1,0,329,1
# Taylor Swift,Evermore,2020,0,15,299,8.5,1,1,3,0,329,254,1
# 21 Savage,SavageMode2,2020,1,15,299,9.0,7,0,5,2,0,108,0   (collab w/ Metro, kept separate)
# Metro Boomin,HeroesVillains,2022,1,15,489,9.0,14,0,10,0,0,226,0
# Ariana Grande,Sweetener,2018,0,15,207,9.0,21,0,2,2,0,174,1
# Harry Styles,HarryStyles,2017,0,10,120,8.0,30,0,0,0,0,66,0

# 8 features. hype_score dropped (hindsight leak); the three correlated history
# features collapsed into history_per_mau.
FEATS = ['track_count', 'spotify_mau', 'lead_time', 'feature_track_count',
         'years_since_last_album', 'history_per_mau',
         'is_household_name', 'household_x_tracks']

MAU_2026 = 788   # Jul-Dec 2026. Use 761 for a Jan-Jun release.

# --- prep ---
df = pd.read_csv(io.StringIO(csv_content)).sort_values(['artist','year']).reset_index(drop=True)
df['household_x_tracks'] = df['is_household_name'] * df['track_count']
df['spt'] = df['first_week_streams'] / df['track_count']
gm, gm_spt = df[df['year']<=2025]['first_week_streams'].median(), df['spt'].median()
df['prev_album_streams'] = df['prev_album_streams'].replace(0, gm)

def prior_mean(df, col, fallback):
    """Mean over the artist's STRICTLY EARLIER albums. Prevents leakage."""
    out = []
    for _, r in df.iterrows():
        prior = df[(df['artist']==r['artist']) & (df['year']<r['year'])]
        out.append(prior[col].mean() if len(prior) > 0 else fallback)
    return out

df['t_avg'] = prior_mean(df, 'first_week_streams', gm)
df['t_spt'] = prior_mean(df, 'spt', gm_spt)
for col, src in [('trailing_avg_per_mau','t_avg'), ('trailing_spt_per_mau','t_spt'),
                 ('prev_streams_per_mau','prev_album_streams')]:
    df[col] = df[src] / df['spotify_mau']

# Single history signal: last album and career average, averaged.
df['history_per_mau'] = (df['prev_streams_per_mau'] + df['trailing_avg_per_mau']) / 2
df['log_spm'] = np.log(df['first_week_streams'] / df['spotify_mau'])

train, hold, val26 = (df[df['year']<=2024].copy(),
                      df[df['year']==2025].copy(),
                      df[df['year']==2026].copy())

# --- LOOCV ---
MP = dict(n_estimators=200, max_depth=4, min_samples_leaf=3, random_state=42)
X, y = train[FEATS], train['log_spm']
lp, la = [], []
for ti, te in LeaveOneOut().split(X):
    m = RandomForestRegressor(**MP); m.fit(X.iloc[ti], y.iloc[ti])
    lp.append(m.predict(X.iloc[te])[0]); la.append(y.iloc[te[0]])

r2     = r2_score(la, lp)
rp     = np.exp(np.array(lp)) * train['spotify_mau'].values
ra     = train['first_week_streams'].values
mape   = np.mean(np.abs(rp - ra) / ra * 100)
medape = np.median(np.abs(rp - ra) / ra * 100)
mae    = np.mean(np.abs(rp - ra))
r2_raw = r2_score(ra, rp)   # same predictions, scored on the raw stream scale

model = RandomForestRegressor(**MP)
model.fit(X, y)

# --- helpers ---
def predict(params, mau):
    Xi = pd.DataFrame([params], columns=FEATS)
    tp = np.array([np.exp(t.predict(Xi)[0]) * mau for t in model.estimators_])
    return np.mean(tp), np.percentile(tp, 10), np.percentile(tp, 90)

def artist_params(artist, tracks, lead, feats, years, mau, before_year=2026):
    """Build a feature row for a new album. before_year restricts the artist's history
    to strictly earlier albums, matching how the training features were built."""
    full = df[df['artist']==artist].sort_values('year')
    a = full[full['year'] < before_year]
    is_hh = int(full.iloc[-1]['is_household_name']) if len(full) else 0
    prev = (a.iloc[-1]['first_week_streams'] if len(a) else gm) / mau
    tavg = (a['first_week_streams'].mean()   if len(a) else gm) / mau
    return [tracks, mau, lead, feats, years, (prev + tavg) / 2, is_hh, is_hh * tracks]

# --- 2026 case study: predicted ahead of each release -------------------------
# LOGGED values from the original model, kept as a record of what was actually
# predicted before each album came out. They are NOT recomputed here. The model has
# since been revised and would give different figures today; recomputing them would
# turn a forecast into a retrodiction.
CASE_STUDY = [
    ("DRAKE - ICEMAN",              479, 450.4, 22),
    ("OLIVIA RODRIGO - YSPSFAGSIL", 413, 394.7, 13),
    ("ARIANA GRANDE - PETAL",       408, 236.1, 12),
]

BOLD, BLUE, GREEN, RED, AMBER, RESET = "\033[1m", "\033[34m", "\033[32m", "\033[31m", "\033[33m", "\033[0m"
COL_W = [32, 9, 9, 21, 10, 9]

def fmt_row(label, m, tc, mape, actual):
    lo, hi = int(m*(1-mape/100)), int(m*(1+mape/100))
    d = (m - actual) / actual * 100
    c = GREEN if abs(d) < 15 else (AMBER if abs(d) < 30 else RED)
    return (label.ljust(COL_W[0])
            + (f"{BOLD}{BLUE}{int(m)}M{RESET}").ljust(COL_W[1] + len(BOLD+BLUE+RESET))
            + f"{m/tc:.1f}M".ljust(COL_W[2])
            + f"{lo}M-{hi}M".ljust(COL_W[3])
            + (f"{BOLD}{GREEN}{actual:.1f}M{RESET}").ljust(COL_W[4] + len(BOLD+GREEN+RESET))
            + f"{c}{BOLD}{d:+.1f}%{RESET}")

W = 100
hdr = ["ARTIST & ALBUM", "MODEL", "SPT", "RANGE (+/-" + f"{mape:.0f}" + "% MAPE)", "ACTUAL", "% DIFF"]

print("\n" + "="*W)
print(f"{'SUMMER 2026 CASE STUDY  (predicted ahead of each release)':^{W}}")
print("="*W)
print("  " + "".join(h.ljust(w) for h, w in zip(hdr, COL_W)))
print("  " + "-"*sum(COL_W))
for label, pred, actual, tc in CASE_STUDY:
    print("  " + fmt_row(label, pred, tc, mape, actual))
print("\n  Logged with the original 11-feature model. Not recomputed.")
print("  Two of three landed within 7%.")

print("\n" + "="*W + f"\n2025 HOLDOUT  ({len(hold)} albums, never seen in training)\n" + "="*W)
print(f"  {'ALBUM':<38}  {'PRED':>5}  {'ACTUAL':>6}  {'ERR':>9}\n  " + "-"*68)
herrs = []
for _, r in hold.iterrows():
    p,_,_ = predict(r[FEATS].tolist(), r['spotify_mau'])
    e = abs(p - r['first_week_streams']) / r['first_week_streams'] * 100
    herrs.append(e)
    over = 'over' if p > r['first_week_streams'] else 'under'
    print(f"  {r['artist']+' '+r['album']:<38}  {int(p):>4}M  {int(r['first_week_streams']):>5}M  {e:>7.1f}% ({over})")
print(f"  >> Holdout MAPE: {np.mean(herrs):.1f}%")

print("\n" + "="*W + "\n2026 VALIDATION  (known result, not trained on)\n" + "="*W)
for _, r in val26.iterrows():
    p,_,_ = predict(r[FEATS].tolist(), r['spotify_mau'])
    e = abs(p - r['first_week_streams']) / r['first_week_streams'] * 100
    over = 'over' if p > r['first_week_streams'] else 'under'
    print(f"  {r['artist']+' '+r['album']:<38}  {int(p):>4}M  {int(r['first_week_streams']):>5}M  {e:>7.1f}% ({over})")
print(f"  Note: {len(val26)} album. A single observation cannot estimate an error rate.")
print("  The 2025 holdout above is the real out-of-sample test.")

print("\n" + "="*W + "\nFEATURE IMPORTANCE\n" + "="*W)
for f, v in pd.Series(model.feature_importances_, index=FEATS).sort_values(ascending=False).items():
    print(f"  {f:<25}  {v:.3f}  " + "#"*int(v*44))

print("="*W)
print(f"\n  train={len(train)} rows | features={len(FEATS)} | R2(log)={r2:.3f} | "
      f"MAPE={mape:.1f}% | median={medape:.1f}% | MAE={mae:.0f}M")
print(f"  R2 on the raw stream scale = {r2_raw:.3f}. The {r2:.2f} above is measured on")
print("  log(streams/MAU); on raw streams a few outsized albums dominate the variance.")
print("="*W + "\n")
